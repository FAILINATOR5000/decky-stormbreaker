{
  "name": "decky-stormbreaker",
  "version": "0.1.0",
  "private": true,
  "description": "Prevents and treats a rare SteamOS glitch where the Quick Access Menu (QAM) gets stuck upon opening, leaving controls unresponsive.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FAILINATOR5000/decky-stormbreaker.git"
  },
  "keywords": [
    "freeze",
    "quick access menu",
    "decky",
    "plugin",
    "steam",
    "deck",
    "steamos"
  ],
  "author": "FAILINATOR5000",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/FAILINATOR5000/decky-stormbreaker/issues"
  },
  "homepage": "https://github.com/FAILINATOR5000/decky-stormbreaker#readme",
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.3",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.8.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
